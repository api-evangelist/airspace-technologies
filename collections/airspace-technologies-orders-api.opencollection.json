            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Will activate order if the order status is will call. If the order is not a will call order a 409 conflict is returned"
        },
