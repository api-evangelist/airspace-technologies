            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Will activate order if the order status is will call or recently aquired quotes. If the order is not a\nwill call order or a quote a 409 conflict is returned.\n\n**NOTE:** Can only provide paramaters pickup_time and/or shipment_viability if the order is a will call\norder.\n"
        },
